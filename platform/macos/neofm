#!/bin/sh
set -eu
# Resolve installed symlink, retain caller's working directory.
if [ -L "$0" ]; then
  self="$(/usr/bin/readlink "$0")"
  case "$self" in /*) ;; *) self="$(dirname "$0")/$self";; esac
else
  self="$0"
fi
root="$(cd "$(dirname "$self")/.." && pwd -P)"
state="$HOME/.local/state/lfmac"
umask 077
mkdir -p "$state/config" "$state/cache" "$state/data" "$state/state" "$state/runtime"
export LF_CONFIG_HOME="$state/config" LF_DATA_HOME="$state/data"
unset LFP_POC_TRACE LFP_QL_DRY_RUN LFP_QL_TRACE
# Dedicated config avoids changes to existing lf configuration.
cfg="$(mktemp "$state/config/lfrc.XXXXXX")"
trap 'rm -f "$cfg"' EXIT HUP INT TERM
# The installed preview executable has no spaces in its default path; quoted config supports spaces.
printf 'set preview\nset hidden\nset nopreload\nset ratios 1:2:4\nset previewer "%s"\nnmap <space> \044{{ /usr/bin/qlmanage -p "$f" }}\nnmap <c-space> :toggle; down\n' "$root/bin/lfpreview" > "$cfg"
cat >> "$cfg" <<'LFRCKEYS'
# NeoFM Keymap v1.0
nmap y
nmap d
nmap yy copy
nmap p paste
nmap x cut
nmap dd delete
cmd open :toggle
nmap <enter> open
nmap o &{{ /usr/bin/open "$f" }}
nmap <c-space> toggle
LFRCKEYS
printf 'cmd delete \044{{ "%s/bin/lf-trash" }}\n' "$root" >> "$cfg"
# Pass a path or standard lf args through, defaulting to current working directory.
"$root/bin/lf" -single -config "$cfg" "$@"
